# ── Database: Postgres + pgvector (e.g. Supabase) ──────────────────────────────
# Use the transaction-pooled connection string for serverless (Vercel).
DATABASE_URL=

# ── Anthropic (Claude API) — answers, contract vision ──────────────────────────
ANTHROPIC_API_KEY=

# ── Embeddings: Voyage AI (multilingual RAG) ───────────────────────────────────
# Anthropic has no embeddings endpoint; retrieval uses a separate provider.
VOYAGE_API_KEY=

# ── Supabase (admin Auth) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Observability (optional in development) ────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
