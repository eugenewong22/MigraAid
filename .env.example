# ── Database: Postgres + pgvector (e.g. Supabase) ──────────────────────────────
# Least-privilege, transaction-pooled runtime connection for serverless (Vercel).
# Supabase: the transaction pooler — host aws-*.pooler.supabase.com, port 6543.
DATABASE_URL=
# Table-owner/session connection used only by release-time migration commands.
# Supabase: the SESSION pooler — same host as DATABASE_URL but port 5432 (the
# 6543 transaction pooler cannot run drizzle-kit migrations). Required in the
# Vercel Production environment: `vercel-build` applies pending migrations
# before every production build and fails the deploy if this is missing, so
# code can never ship ahead of the schema. Never expose it to the app runtime.
MIGRATION_DATABASE_URL=

# ── OpenAI — grounded answers, contract vision, embedding fallback ─────────────
OPENAI_API_KEY=

# ── Embeddings: Voyage AI (multilingual RAG) ───────────────────────────────────
# Voyage is preferred for multilingual retrieval. If omitted, OpenAI embeddings
# are used with OPENAI_API_KEY instead.
VOYAGE_API_KEY=

# ── Supabase (admin Auth) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local UI development only. The bypass is ignored in production and must never
# be configured on a preview or public deployment.
ALLOW_INSECURE_DEV_ADMIN=false

# Worker conversation and derived contract-analysis retention (default: 30 days).
DATA_RETENTION_DAYS=30
# 32+ random characters. Vercel Cron sends this as a Bearer token.
CRON_SECRET=
# Optional minimum cosine similarity required before the RAG model may answer.
RAG_MIN_SCORE=0.35

# Optional fleet-wide rate limiting. Without these, local in-memory limits apply.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_SALT=
# Outside Vercel, enable only when your own reverse proxy strips and rewrites
# x-real-ip/x-forwarded-for. Never trust client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false

# ── Observability (optional in development) ────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional build-time source-map upload configuration.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=
