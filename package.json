{
  "name": "migraaid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/release/check-env.ts && tsx scripts/release/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "ingest": "tsx scripts/ingest/run.ts",
    "sources:fetch": "tsx scripts/sources/fetch.ts",
    "sources:check": "tsx scripts/sources/check.ts",
    "content:draft": "tsx scripts/content/draft.ts",
    "content:rollback": "tsx scripts/content/rollback.ts",
    "content:restore": "tsx scripts/content/restore.ts",
    "eval": "tsx scripts/eval/run.ts",
    "eval:offline": "tsx scripts/eval/offline.ts",
    "icons": "tsx scripts/icons/generate.ts",
    "check:env": "tsx scripts/release/check-env.ts",
    "privacy:cleanup": "tsx scripts/privacy/cleanup.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.65.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "next-intl": "^4.13.2",
    "openai": "^7.1.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
